# Copy to .env and fill in. Never commit .env, credentials, tokens, or real identity data.

# From the NamoID Console: a *confidential web application* in a Test environment.
# Register this exact callback URL in the Console:  <APP_BASE_URL>/api/auth/callback
NAMOID_CLIENT_ID=namoid_client_test_xxxxxxxxxxxxxxxx
NAMOID_CLIENT_SECRET=namoid_secret_test_xxxxxxxxxxxxxxxx

# Public origin the browser uses. Local dev (Vite on 5174 proxies /api to Express on 4000):
APP_BASE_URL=http://localhost:5174
PORT=4000

# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# DEMO_MODE=true lets signed-in users pick their own demo roles and move the demo clock (both audited).
DEMO_MODE=true

# DEV_LOGIN=true adds fictional persona logins for local work before the NamoID app exists.
# It is refused when NODE_ENV=production.
DEV_LOGIN=false

# Where the JSON snapshot of mock state lives.
DATA_FILE=data/state.json

# Proxy hops in front of Express whose X-Forwarded-For we trust (1 locally and on Render).
TRUST_PROXY=1
