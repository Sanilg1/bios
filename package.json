{
  "name": "namoid-challenge-submission",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/validate.mjs",
    "dev": "concurrently -k -n api,web -c green,blue \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "sample-history": "node scripts/export-sample-history.mjs",
    "landing": "python3 -m http.server 8080"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@namoidhq/js": "^3.2.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "vite": "^6.0.0"
  }
}
